# ---------- 复制为 .env 后按需修改 ----------
# 本项目零依赖，.env 由 server/index.js 内置的轻量解析器读取，不需要 dotenv。
# 环境变量优先于 config/endpoints.json 里的同名字段。

# 监听端口 / 地址（服务器上建议 127.0.0.1 + Nginx 反代；本机想用手机访问就写 0.0.0.0）
PORT=8787
HOST=0.0.0.0

# 游戏周基准时区（点赞每周一 00:00:01 重置并结算）
TIME_ZONE=Asia/Shanghai

# SQLite 数据库文件（用户 / 角色 / 点赞记录都在这里）
DB_FILE=./data/kimuzhi.db

# ---------------- 管理员 ----------------
# 不配的话：系统里一个管理员都没有时会自动建 admin / admin123 并告警。
# 建议在这里配好自己的账号密码，或者用 npm run admin -- 账号 密码 创建。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=换成你自己的密码

# ---------------- 接口适配器 ----------------
# http = 真实接口（默认，配置在 config/endpoints.json）
# mock = 假数据，用于没接口时演示 / 本地调界面
ADAPTER=http

# 接口服务的访问密钥（在它的管理界面里设置的那个）。留空表示不需要。
# 建议写在这里而不是 config/endpoints.json —— .env 不会被提交，也不会被部署覆盖。
API_KEY=

# 只想用环境变量配置接口时：一个地址同时覆盖接口 A / 接口 B
# API_BASE_URL=https://hp.likeun.com/
# API_A_ROLEID_PATH=roleId
# API_B_LIKES_PATH=likeTimes
# API_A_REGION_QQ=1
# API_A_REGION_WECHAT=2

# ---------------- 本地模式 ----------------
# 1（默认）= 未登录也能用，账号只存在访客浏览器里，不入库、后台看不到
# 0 = 关掉，未登录时添加账号会提示必须先注册
ALLOW_LOCAL_MODE=1

# ---------------- 定时任务 ----------------
# 每周结算的宽限窗口（毫秒）：周一 05:00 之后多久内允许用「刚查到的值」直接作为新基线
SETTLE_GRACE_MS=600000
# 自动刷新全部账号的间隔（分钟），0 = 关闭
AUTO_REFRESH_MINUTES=0

# ---------------- 接口限速重试 ----------------
# 不做主动限速、不管额度；接口提示「请求过于频繁」时自动退避重新请求
# API_A_RETRY_ON_RATE_LIMIT=3
# API_B_RETRY_ON_RATE_LIMIT=3

# ---------------- Mock 专用 ----------------
# 时间加速倍数：周一到下周一原本 168 小时，设为 200 则约 50 分钟走完一周，方便验证跨周结算
MOCK_SPEED=1
